# Obsidian Vault 경로 설정
# 본인의 Google Drive 경로에 맞게 수정하세요
# macOS 예시:
# OBSIDIAN_VAULT_PATH=/Users/사용자명/Library/CloudStorage/GoogleDrive-계정/경로/Obsidian Vault

# Windows 예시:
# OBSIDIAN_VAULT_PATH=C:\Users\사용자명\Google Drive\경로\Obsidian Vault

OBSIDIAN_VAULT_PATH=YOUR_OBSIDIAN_VAULT_PATH_HERE

# 블로그 동기화 옵션 (선택사항)
# SYNC_WATCH_MODE=false
# SYNC_AUTO_DEPLOY=false