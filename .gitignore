# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# worktrees
.worktrees/

# tooling
.claude/settings.local.json
.playwright-mcp/
.serena/

# local design references
post-xl.png

# 디자인 캔버스 산출물(2MB+). 작업 파일(*.dc.html, canvas.json, gen*.mjs)은 추적한다.
docs/design/**/*.html
!docs/design/**/*.dc.html
